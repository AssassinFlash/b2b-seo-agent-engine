      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can a 4-meter laser-cut metal room divider be installed without cutting into existing marble flooring?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — by using a top-hung structural header beam paired with a concealed 3M VHB + compression silicone bottom shoe instead of core-drilled floor pins. This keeps lateral deflection under 2.0 mm while preserving stone slabs and underfloor heating loops."
          }
        }
      ]
